{
  // Tailwind v4의 @theme / @custom-variant / @apply 는 표준 CSS가 아니라
  // VS Code 내장 CSS 언어 서비스가 "Unknown at rule" 로 경고한다.
  // Tailwind CSS IntelliSense 확장이 문법을 대신 이해하므로 내장 린트는 끈다.
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",

  // CSS 파일을 Tailwind 언어 모드로 열어 자동완성을 받는다.
  "files.associations": {
    "*.css": "tailwindcss"
  },

  // Biome를 포맷터로 고정 (Prettier 미사용)
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit"
  }
}
