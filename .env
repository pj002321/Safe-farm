# 이 파일은 git에 추적됩니다 (프라이빗 레포 전제).
# 개인별 값이 필요하면 .env.local 을 쓰세요 — Next가 자동으로 읽고 우선합니다.
#
# ⚠️ 플레이스홀더입니다. Supabase 프로젝트 생성 후 교체하세요.
#    리전은 Northeast Asia (Seoul) / ap-northeast-2 를 고를 것.

# ── 브라우저 노출 OK (publishable 키. RLS가 방어선) ──────────
# 이름 주의: 구 NEXT_PUBLIC_SUPABASE_ANON_KEY 가 아니라 PUBLISHABLE_KEY 입니다.
NEXT_PUBLIC_SUPABASE_URL=https://replace-me.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# ── 서버 전용. NEXT_PUBLIC_ 접두 절대 금지 ────────────────────
# RLS를 우회하는 전권 키. app_metadata.role 변경 등에만 사용.
SUPABASE_SECRET_KEY=

# LangGraph checkpointer 용. Supavisor transaction mode(6543)를 쓸 것 —
# direct 접속은 IPv6 전용이라 Vercel 함수에서 ENETUNREACH 로 죽습니다.
POSTGRES_URL=
