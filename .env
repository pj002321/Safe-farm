# ⚠️ 이 파일은 git에 추적됩니다. **비밀값을 절대 넣지 마세요.**
#    (.gitignore 가 의도적으로 제외하지 않습니다 — 키 이름과 형식을 공유하려는 목적입니다.)
#
# 값을 넣는 곳:
#   개인별로 다른 값이 필요해지면 그때 .env.local 을 만드세요 (git 무시됨,
#   Next 가 이 파일보다 우선해서 읽습니다). 지금은 전부 공개값이라 필요 없습니다.
#
#   서비스 계정 키는 환경변수가 아니라 파일입니다: secrets/firebase-adminsdk.json
#
# **예외: Firebase 공개 설정은 여기에 실제 값을 둡니다.**
# 웹 SDK 설정(apiKey 포함)은 브라우저 번들에 그대로 실리도록 설계된 공개
# 식별자입니다. apiKey 는 인증 수단이 아니라 "어느 프로젝트냐"를 가리키는 값이고,
# 실제 방어선은 Firebase Auth 설정 · Firestore 보안 규칙 · App Check 입니다.
# 그래서 추적되는 파일에 값이 있어도 유출이 아닙니다.

# ── 브라우저 노출 OK (Firebase 웹 설정. 위 설명 참고) ──────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDZdjHlmyJgmAWy7ZjhWiKlWb7aLFz6IDQ
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=safe-farm-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=safe-farm-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=safe-farm-ai.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1083499463635
NEXT_PUBLIC_FIREBASE_APP_ID=1:1083499463635:web:4c42ae71faddde9ceda526

# ── 서버 전용 시크릿. 여기엔 이름만 두고 값은 .env.local 이나 배포 환경변수에 ──
# 절대 NEXT_PUBLIC_ 접두를 붙이지 마세요.

# Firestore 데이터베이스 ID. 비밀이 아니다.
# SDK 기본값은 `(default)`(괄호 포함)인데, 이 프로젝트의 데이터베이스는 콘솔에서
# 이름을 직접 정해 만들어져 `default`(괄호 없음)다. 비워두면 모든 Firestore 호출이
# `5 NOT_FOUND` 로 죽는다 — 오류에 원인이 드러나지 않으니 이 줄을 지우지 말 것.
FIREBASE_FIRESTORE_DATABASE_ID=default
