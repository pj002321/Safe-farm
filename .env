# 이 파일은 git에 추적됩니다 (프라이빗 레포 전제).
# 개인별로 다른 값이 필요하면 .env.local 을 쓰세요 — Next가 자동으로 읽고 우선합니다.
#
# ⚠️ 아래는 전부 플레이스홀더입니다. InsForge 프로젝트를 만든 뒤 실제 값으로 교체하세요.
#    스키마 검증(src/shared/config/env.ts)이 형식만 보므로 지금은 빌드가 통과하지만,
#    실제 호출은 당연히 실패합니다.

# ── 브라우저 노출 OK (anon 키. RLS가 방어선) ──────────────────
NEXT_PUBLIC_INSFORGE_URL=https://replace-me.ap-southeast.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=REPLACE_ME

# ── 서버 전용. NEXT_PUBLIC_ 접두 절대 금지 ────────────────────
# RLS를 우회하는 전권 admin 키  (npx @insforge/cli secrets get API_KEY)
INSFORGE_API_KEY=ik_REPLACE_ME
# postgres 특권 롤. LangGraph checkpointer 전용
DATABASE_URL=postgresql://postgres:REPLACE_ME@replace-me.ap-southeast.database.insforge.app:5432/insforge?sslmode=require
# LLM 프로바이더 키
OPENROUTER_API_KEY=
