# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 의도적으로 추적한다 (이 레포는 퍼블릭이므로 실제 키를 넣지 말 것)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent meta
.claude/.headroom_wrap_marker.json
.claude/.headroom_wrap_owners.json
.claude/.headroom_wrap_settings.lock
# Claude Code — 개인 설정 (내 PC 경로·로컬 프록시가 들어간다)
# 팀 규칙은 AGENTS.md, 팀 공용 스킬은 .claude/skills/ 에 두고 커밋한다.
.claude/settings.local.json
