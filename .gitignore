# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# .env 는 키 "이름"을 공유하려고 의도적으로 추적한다. 실제 값은 넣지 않는다.
# 값은 .env.local(로컬) 또는 배포 환경의 환경변수에만 둔다.
# (`.env.local` + `.env.*.local` 은 `.env*.local` 과 동치다 — ai-service/.env.local 도 걸린다.)
.env.local
.env.*.local


# typescript
*.tsbuildinfo
next-env.d.ts


# Firebase 는 걷어냈지만 배포 캐시 디렉터리가 로컬에 남아 있다.
# 규칙을 빼면 그 캐시가 커밋된다 — 실제로 한 번 그렇게 됐다.
.firebase/
firebase-debug.log*
firestore-debug.log*

# ⚠️ 서비스 계정 키 — 커밋되면 프로젝트 전체 권한이 유출된다.
# 이런 키는 보안 규칙을 통째로 우회하므로 유출 = 전 데이터 읽기·쓰기·삭제 가능.
# 값은 .env.local(로컬) 또는 배포 환경의 환경변수에만 둔다.
*serviceAccount*.json
*-firebase-adminsdk-*.json
# 서비스 계정을 두는 유일한 자리. 파일명이 바뀌어도 새는 일이 없도록 디렉터리째 막는다.
# 실제로 이 파일이 커밋돼 GitHub push protection 에 막힌 적이 있다. 지우지 말 것.
secrets/

# agent meta
.claude/.headroom_wrap_marker.json
.headroom_wrap_marker.json
.serena
ai-service/.env.local
ai-service/.env.*.local
*.pyc

# agent meta
.claude/.headroom_wrap_owners.json
.claude/.headroom_wrap_settings.lock
# Claude Code — 개인 설정 (내 PC 경로·로컬 프록시가 들어간다)
# 팀 규칙은 AGENTS.md, 팀 공용 스킬은 .claude/skills/ 에 두고 커밋한다.
.claude/settings.local.json
